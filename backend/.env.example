# ── Required ──────────────────────────────────────────────────────────────────
MONGO_URL=mongodb+srv://dbHassan:112233.AiolioSDnD@lumina.9c9pbmw.mongodb.net/
DB_NAME=lumina

# Google AI Studio key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional second provider, tried when every Gemini model has failed. Worth
# having: a Gemini quota error takes out all Gemini models at once, so the
# only useful fallback is a different provider. Without it, an outage drops
# you to local extraction, which produces markedly worse notes.
# Free key: https://console.groq.com/keys
GROQ_API_KEY=

# OAuth 2.0 Web client ID from https://console.cloud.google.com/apis/credentials
# Add your frontend origin to "Authorised JavaScript origins".
GOOGLE_CLIENT_ID=

# Signs session tokens. Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# If unset, a random one is generated at boot and every restart signs everyone out.
JWT_SECRET=

# Comma-separated frontend origins allowed to call this API.
CORS_ORIGINS=http://localhost:3000

# ── Optional ──────────────────────────────────────────────────────────────────
# JWT_TTL_DAYS=30

# Restrict who may sign in. Leave both empty to allow any Google account.
# ALLOWED_EMAILS=someone@example.com,other@example.com
# ALLOWED_EMAIL_DOMAINS=example.com

# Models are tried left to right; the next one is used if the first fails.
# They must all still be served (a retired model answers 404 and breaks the
# fallback) and must be different models, since quota is counted per model.
# List what your key can reach: GET /v1beta/models?key=YOUR_KEY
# GEMINI_TEXT_MODELS=gemini-3.5-flash,gemini-2.5-flash,gemini-3.1-flash-lite
# GEMINI_AUDIO_MODELS=gemini-3.5-flash,gemini-2.5-flash,gemini-3.1-flash-lite
# GEMINI_TIMEOUT=120
# GEMINI_MAX_ATTEMPTS=3

# Long transcripts are summarized window by window and merged, for BOTH
# providers. Groq's free tier forces it; Gemini is windowed because one pass
# over an hour covers the ends and thins out in the middle. On a 78 minute
# lecture this was the difference between 56 bullets and 104.
# GEMINI_WINDOW_CHARS=24000
# A window refused as too large is halved and retried, down to this floor.
# MIN_WINDOW_CHARS=2500

# Groq chat models for notes, and Whisper for speech. List models the key can
# actually reach: GET https://api.groq.com/openai/v1/models
# GROQ_TEXT_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b,openai/gpt-oss-20b
# GROQ_AUDIO_MODELS=whisper-large-v3,whisper-large-v3-turbo
# Groq's free tier refuses a request over a few thousand tokens, so a long
# transcript is summarized in windows of this many characters and merged.
# GROQ_WINDOW_CHARS=18000
# GROQ_TIMEOUT=120
# A rate limit says when it will accept the next request; waiting turns a
# missing stretch of the notes into a slower summary.
# GROQ_MAX_ATTEMPTS=4
# GROQ_MAX_RETRY_WAIT=35

# Limits
# MAX_AUDIO_BYTES=26214400
# MAX_TRANSCRIPT_CHARS=400000
# AUDIO_CHUNK_SECONDS=240
# RATE_LIMIT_AI_REQUESTS=30
# RATE_LIMIT_AI_WINDOW=60

# One-time migration: hands notes saved before accounts existed to this account,
# the next time the server boots after that user has signed in once.
# LEGACY_OWNER_EMAIL=you@example.com
